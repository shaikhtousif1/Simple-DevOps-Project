## 🧩 Final Layout (Inline Integration)

You probably already have:

```
eks/
 ├── main.tf
 ├── variables.tf
 ├── outputs.tf
 └── dev.auto.tfvars
```

We’ll modify **main.tf**, and if needed, lightly touch **variables.tf** and **outputs.tf**.

---

## 🔧 Step 1 — Add variables (if not already present)

Add these in your `variables.tf` (if missing):

```hcl
variable "vpc_id" {
  description = "Existing VPC ID for EKS cluster"
  type        = string
}

variable "eks_cluster_subnet_ids" {
  description = "Private subnet IDs for EKS cluster and node groups"
  type        = list(string)
}

variable "aws_region" {
  description = "Region for AWS resources"
  type        = string
}

variable "prefix" {
  description = "Prefix for resource naming"
  type        = string
}

variable "allowed_cidrs" {
  description = "CIDR blocks allowed to access VPC interface endpoints"
  type        = list(string)
  default     = ["10.0.0.0/8"] # adjust for your org network
}
```

---

## 🧠 Step 2 — Paste this entire block **at the top** of your `main.tf` (before EKS cluster resource)

This ensures the endpoints are created **before** EKS provisioning starts.

```hcl
########################################
# VPC Endpoints for Private EKS Cluster
########################################

locals {
  interface_endpoints = [
    "com.amazonaws.${var.aws_region}.ec2",
    "com.amazonaws.${var.aws_region}.ecr.api",
    "com.amazonaws.${var.aws_region}.ecr.dkr",
    "com.amazonaws.${var.aws_region}.eks"
  ]
}

# --- Security Group for Interface Endpoints ---
resource "aws_security_group" "vpc_endpoints_sg" {
  name        = "${var.prefix}-vpc-endpoints-sg"
  description = "Security group for VPC interface endpoints"
  vpc_id      = var.vpc_id

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = var.allowed_cidrs
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.prefix}-vpc-endpoints-sg"
  }
}

# --- Interface Endpoints (EKS, ECR, EC2) ---
resource "aws_vpc_endpoint" "interface_endpoints" {
  for_each = toset(local.interface_endpoints)

  vpc_id              = var.vpc_id
  service_name        = each.value
  vpc_endpoint_type   = "Interface"
  subnet_ids          = var.eks_cluster_subnet_ids
  security_group_ids  = [aws_security_group.vpc_endpoints_sg.id]
  private_dns_enabled = true

  tags = {
    Name = "${var.prefix}-${replace(each.value, "com.amazonaws.${var.aws_region}.", "")}-vpce"
  }
}

# --- S3 Gateway Endpoint (Recreate or Reuse) ---
data "aws_route_tables" "private" {
  vpc_id = var.vpc_id
}

data "aws_vpc_endpoint_service" "s3" {
  service = "s3"
}

# Check if S3 endpoint already exists
data "aws_vpc_endpoint" "existing_s3" {
  for_each = toset([var.vpc_id])
  vpc_id   = each.key
  filter {
    name   = "service-name"
    values = ["com.amazonaws.${var.aws_region}.s3"]
  }
}

resource "aws_vpc_endpoint" "s3_gateway" {
  count             = length(data.aws_vpc_endpoint.existing_s3) == 0 ? 1 : 0
  vpc_id            = var.vpc_id
  service_name      = "com.amazonaws.${var.aws_region}.s3"
  vpc_endpoint_type = "Gateway"
  route_table_ids   = data.aws_route_tables.private.ids

  tags = {
    Name = "${var.prefix}-s3-vpce"
  }
}
```

---

## 🧩 Step 3 — Add this **right after your EKS module or resource**

This ensures EKS waits for endpoint creation.

If you’re using the `terraform-aws-modules/eks/aws` module:

```hcl
module "eks" {
  source = "terraform-aws-modules/eks/aws"

  cluster_name = "${var.prefix}-eks"
  vpc_id       = var.vpc_id
  subnet_ids   = var.eks_cluster_subnet_ids
  cluster_endpoint_private_access = true
  cluster_endpoint_public_access  = false

  enable_irsa = true

  # 👇 Ensures endpoints are ready before EKS starts
  depends_on = [
    aws_vpc_endpoint.interface_endpoints,
    aws_vpc_endpoint.s3_gateway
  ]
}
```

If you’re creating the cluster directly via `aws_eks_cluster` resource:

```hcl
resource "aws_eks_cluster" "this" {
  name     = "${var.prefix}-eks"
  vpc_config {
    subnet_ids              = var.eks_cluster_subnet_ids
    endpoint_private_access = true
    endpoint_public_access  = false
  }

  depends_on = [
    aws_vpc_endpoint.interface_endpoints,
    aws_vpc_endpoint.s3_gateway
  ]
}
```

---

## 🧩 Step 4 — Add simple outputs for visibility (optional)

At the bottom of your `outputs.tf`:

```hcl
output "vpc_interface_endpoints" {
  value = [for ep in aws_vpc_endpoint.interface_endpoints : ep.id]
}

output "s3_gateway_endpoint" {
  value = length(aws_vpc_endpoint.s3_gateway) > 0 ? aws_vpc_endpoint.s3_gateway[0].id : "Existing S3 endpoint reused"
}
```

---

## 🧪 Step 5 — Run Terraform

```bash
terraform apply -var-file=dev.auto.tfvars
```

Expected:

* You’ll see 4 new `Interface` endpoints being created (EKS, EC2, ECR API, ECR DKR)
* `S3 Gateway` will be either reused or created if missing
* EKS cluster provisioning will start *after* those endpoints
* Worker nodes will bootstrap and join without error

Check after apply:

```bash
kubectl get nodes
```

✅ You should see your nodes in `Ready` state
✅ No more `NodeCreationFailure`

